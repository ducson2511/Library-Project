<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#173d36">
<title>SFBU Library | Online Research Tools</title>
<style>
:root{--green:#173d36;--green2:#285d4f;--cream:#f6f5ee;--paper:#fffefa;--ink:#20332d;--muted:#64726b;--line:#e3e6dc;--lime:#e2edb6;--gold:#c49a5b}
*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font:16px/1.55 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}.wrap{width:min(1120px,calc(100% - 36px));margin:auto}
.top{background:var(--green);color:#e7ecd9;text-transform:uppercase;letter-spacing:.1em;font-size:.75rem;padding:12px 0}.top .wrap{display:flex;justify-content:space-between}.top strong{font-weight:800}
.hero{position:relative;overflow:hidden;background:linear-gradient(115deg,#173d36 0%,#234e41 60%,#67806a 100%);color:white;padding:70px 0 64px}
.hero:after{content:"";position:absolute;right:4%;bottom:-100px;width:360px;height:360px;border:1px solid #ffffff2d;border-radius:50%;box-shadow:0 0 0 34px #ffffff0c,0 0 0 74px #ffffff09}
.hero-inner{position:relative;z-index:1;max-width:720px}.eyebrow{color:var(--lime);text-transform:uppercase;font-size:.75rem;letter-spacing:.16em;font-weight:800}.eyebrow:before{content:"";display:inline-block;width:26px;height:2px;background:var(--gold);vertical-align:middle;margin-right:10px}
h1{font:500 clamp(2.8rem,7vw,5rem)/.98 Georgia,serif;letter-spacing:-.04em;margin:20px 0} .hero p{max-width:590px;color:#e3e9df;font-size:1.08rem;margin:0}
.actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:26px}.button{display:inline-flex;align-items:center;gap:8px;padding:11px 16px;border-radius:4px;font-weight:750;font-size:.9rem;text-decoration:none}.primary{background:var(--lime);color:#1c342d}.secondary{border:1px solid #ffffff70;color:#fff}.button:hover{filter:brightness(1.06)}
main{padding:50px 0 64px}.heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:23px}.kicker{margin:0 0 7px;color:var(--green2);font-weight:850;font-size:.73rem;text-transform:uppercase;letter-spacing:.15em}h2{font:500 clamp(2rem,4vw,2.8rem)/1.08 Georgia,serif;letter-spacing:-.03em;margin:0}.heading p{max-width:350px;margin:0;color:var(--muted);font-size:.92rem}
.search{width:100%;border:1px solid #d8ded3;background:#fffefa;padding:12px 14px;border-radius:5px;font:inherit;margin-bottom:16px;outline:none}.search:focus{border-color:var(--green2);box-shadow:0 0 0 3px #285d4f20}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.card{display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:22px;min-height:235px;transition:.18s}.card:hover{transform:translateY(-3px);box-shadow:0 12px 28px #18332b12;border-color:#c6d2bd}.featured{grid-column:span 2;background:#edf1e2;border-color:#d4dfc4;min-height:205px}
.cardhead{display:flex;gap:13px;align-items:flex-start}.icon{width:40px;height:40px;flex:0 0 40px;border-radius:50%;display:grid;place-items:center;background:#e8eddf;color:var(--green2);font-weight:900;font-size:1.1rem}.featured .icon{background:var(--green);color:var(--lime)}
.num{font-size:.68rem;letter-spacing:.13em;text-transform:uppercase;color:#7b897e;font-weight:850;margin:1px 0 4px}h3{font:500 1.34rem/1.2 Georgia,serif;margin:0}.card p{font-size:.9rem;color:#596a61;margin:12px 0 0}.best{font-size:.86rem!important;color:#294238!important}.best b{color:var(--green2)}
.tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:13px}.tag{font-size:.69rem;font-weight:700;color:#617467;border:1px solid #dbe3d6;border-radius:20px;padding:3px 8px}
.bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:auto;padding-top:18px}.access{font-size:.75rem;color:#718078}.open{display:inline-flex;align-items:center;gap:7px;color:var(--green2);font-weight:800;text-decoration:none;font-size:.84rem;white-space:nowrap}.open:hover{text-decoration:underline}.arrow{font-size:1rem}
.tip{margin-top:24px;background:#f0eee3;border-left:3px solid var(--gold);padding:16px 18px;color:#59675f;font-size:.88rem}.tip b{color:#30483c}
footer{background:var(--green);color:#e5eadc;padding:22px 0;font-size:.78rem}footer .wrap{display:flex;justify-content:space-between;gap:16px}footer a{color:var(--lime)}
@media(max-width:700px){.hero{padding:58px 0 50px}.heading{display:block}.heading p{margin-top:10px}.grid{grid-template-columns:1fr}.featured{grid-column:auto}.card{min-height:215px}footer .wrap{display:block}}
</style>
</head>
<body>
<div class="top"><div class="wrap"><strong>SFBU Library</strong><span>Research · Discover · Learn</span></div></div>
<header class="hero"><div class="wrap"><div class="hero-inner">
<div class="eyebrow">Your online research guide</div>
<h1>Find the right source<br>for your next idea.</h1>
<p>Explore SFBU Library’s databases, ebooks, physical collection, and scholarly search tools—all in one place.</p>
<div class="actions"><a class="button primary" href="#tools">Explore the tools <span>→</span></a><a class="button secondary" href="https://library.sfbu.edu/c.php?g=1442521" target="_blank" rel="noopener">Start with Search All ↗</a></div>
</div></div></header>
<main id="tools"><div class="wrap">
<div class="heading"><div><p class="kicker">Choose a starting point</p><h2>Seven tools. One library.</h2></div><p>Start broad, search a subject database, browse books, or follow citations to discover more research.</p></div>
<input class="search" id="filter" type="search" placeholder="Filter tools by name or subject…" aria-label="Filter research tools">
<div class="grid" id="cards">
<article class="card featured" data-search="search all ebsco discovery service articles books journals reports interlibrary loan">
<div class="cardhead"><div class="icon">⌕</div><div><div class="num">01 · Start here</div><h3>Search All (EBSCO Discovery Service)</h3></div></div>
<p>One search box covers the library’s subscription databases, catalog, and open-access collections. Find print and ebook titles, journal and magazine articles, and special reports.</p>
<p class="best"><b>Best for:</b> Starting a search when you’re not sure which database to use.</p>
<div class="tags"><span class="tag">Advanced filters</span><span class="tag">Boolean search</span><span class="tag">Interlibrary Loan requests</span></div>
<div class="bottom"><span class="access"><b>Access:</b> SFBU login</span><a class="open" href="https://library.sfbu.edu/c.php?g=1442521" target="_blank" rel="noopener">Open Search All <span class="arrow">↗</span></a></div>
</article>
<article class="card" data-search="academic search complete multidisciplinary coursework journals magazines psychology videos">
<div class="cardhead"><div class="icon">▤</div><div><div class="num">02 · Multidisciplinary</div><h3>Academic Search Complete</h3></div></div>
<p>Full text from almost 10,000 journals and magazines, including 470 psychology titles, plus over 75,000 Associated Press videos.</p>
<p class="best"><b>Best for:</b> General coursework across subject areas.</p>
<div class="bottom"><span class="access"><b>Access:</b> SFBU login</span><a class="open" href="https://research.ebsco.com/c/bwld2y?db=a9h" target="_blank" rel="noopener">Open database <span class="arrow">↗</span></a></div>
</article>
<article class="card" data-search="business source complete business marketing management company industry market reports case studies">
<div class="cardhead"><div class="icon">▦</div><div><div class="num">03 · Business</div><h3>Business Source Complete</h3></div></div>
<p>Business journals and magazines, plus company, industry, country, and market reports and case studies.</p>
<p class="best"><b>Best for:</b> Business, marketing, and management assignments and company research.</p>
<div class="tags"><span class="tag">3,834 full-text titles</span><span class="tag">Company research</span></div>
<div class="bottom"><span class="access"><b>Access:</b> SFBU login</span><a class="open" href="https://research.ebsco.com/c/e4timw" target="_blank" rel="noopener">Open database <span class="arrow">↗</span></a></div>
</article>
<article class="card" data-search="oreilly higher education ebooks technical professional engineering computer science">
<div class="cardhead"><div class="icon">▤</div><div><div class="num">04 · Digital books</div><h3>O’Reilly for Higher Education</h3></div></div>
<p>Explore a collection of technical and professional books.</p>
<p class="best"><b>May be useful for:</b> Engineering and computer science topics, based on the collection’s technical focus.</p>
<div class="bottom"><span class="access">Sign-in may be required.</span><a class="open" href="https://go.oreilly.com/sfbu-edu" target="_blank" rel="noopener">Open O’Reilly <span class="arrow">↗</span></a></div>
</article>
<article class="card" data-search="ebsco ebook collection full books online digital reading">
<div class="cardhead"><div class="icon">▤</div><div><div class="num">05 · Digital books</div><h3>EBSCO eBook Collection</h3></div></div>
<p>Search the EBSCO ebook collection and read full books online.</p>
<p class="best"><b>Best for:</b> Finding and reading complete books in digital format.</p>
<div class="bottom"><span class="access">Online ebooks</span><a class="open" href="https://research.ebsco.com/c/bwld2y?db=nlebk" target="_blank" rel="noopener">Browse ebooks <span class="arrow">↗</span></a></div>
</article>
<article class="card" data-search="library catalog print physical books borrow">
<div class="cardhead"><div class="icon">▣</div><div><div class="num">06 · Physical collection</div><h3>Library Catalog</h3></div></div>
<p>Search SFBU Library’s print book collection and find physical books to borrow.</p>
<p class="best"><b>Best for:</b> Finding books in the library.</p>
<div class="bottom"><span class="access">Print collection</span><a class="open" href="https://www.librarycat.org/lib/sfbulibrary" target="_blank" rel="noopener">Search catalog <span class="arrow">↗</span></a></div>
</article>
<article class="card" data-search="google scholar scholarly articles books conference papers theses patents citations mla apa chicago">
<div class="cardhead"><div class="icon">⌕</div><div><div class="num">07 · Scholarly search</div><h3>Google Scholar</h3></div></div>
<p>Search articles, books, conference papers, theses, and patents. Some items are free; others may be paywalled.</p>
<p class="best"><b>Best for:</b> Quick broad searches, citation counts, and citation exports in MLA, APA, or Chicago.</p>
<div class="bottom"><span class="access">Use the library guide to reach SFBU full text.</span><a class="open" href="https://library.sfbu.edu/c.php?g=1483791" target="_blank" rel="noopener">Open Scholar guide <span class="arrow">↗</span></a></div>
</article>
</div>
<div class="tip"><b>Not finding full text?</b> Try Search All first. It includes an Interlibrary Loan request option when full text isn’t available.</div>
</div></main>
<footer><div class="wrap"><span><b>SFBU Library</b> · Online Research Tools</span><span>Some resources may require an SFBU login. <a href="https://library.sfbu.edu/c.php?g=1442521">Visit the library research guide</a>.</span></div></footer>
<script>
const filter=document.querySelector("#filter"),cards=[...document.querySelectorAll(".card")];
filter.addEventListener("input",()=>{const q=filter.value.trim().toLowerCase();cards.forEach(card=>card.hidden=!(`${card.dataset.search} ${card.innerText}`).toLowerCase().includes(q))});
</script>
</body>
</html>